{
	"name": "@cotton-forms/app",
	"private": false,
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"import": {
				"types": "./dist/lib/lib.d.ts",
				"import": "./dist/lib/lib.js"
			},
			"require": {
				"types": "./dist/lib/lib.d.cts",
				"require": "./dist/lib/lib.cjs"
			}
		}
	},
	"scripts": {
		"dev": "vite dev",
		"dev:lib": "tsup --watch",
		"build:app": "vite build",
		"build:lib": "tsup",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.0.1",
		"@eslint/compat": "^1.3.0",
		"@eslint/js": "^9.29.0",
		"@internationalized/date": "^3.8.2",
		"@lucide/svelte": "^0.522.0",
		"@playwright/test": "^1.53.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.10",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.8",
		"@types/mustache": "^4.2.6",
		"@types/nodemailer": "^6.4.17",
		"@vitest/browser": "^3.2.4",
		"@vitest/coverage-v8": "^3.2.4",
		"bits-ui": "^2.8.8",
		"bson": "^6.10.4",
		"clsx": "^2.1.1",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.3",
		"formsnap": "^2.0.1",
		"globals": "^16.2.0",
		"jsdom": "^26.1.0",
		"nanoid": "^5.1.5",
		"playwright": "^1.53.1",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"svelte": "^5.34.7",
		"svelte-check": "^4.2.2",
		"svelte-preprocess": "^6.0.3",
		"sveltekit-superforms": "^2.27.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.10",
		"tsup": "^8.5.0",
		"tw-animate-css": "^1.3.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.1",
		"vite": "^6.3.5",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.1.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@sinclair/typebox": "^0.34.36",
		"csv-stringify": "^6.5.2",
		"elysia": "^1.3.5",
		"juice": "^11.0.1",
		"mongodb": "^6.17.0",
		"mustache": "^4.2.0",
		"nodemailer": "^7.0.3",
		"valibot": "^1.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"svelte-preprocess"
		]
	}
}
